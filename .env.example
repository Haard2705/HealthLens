# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=healthlens
POSTGRES_PASSWORD=healthlens
POSTGRES_DB=healthlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://healthlens:healthlens@localhost:5432/healthlens

# Backend
MODEL_DIR=ml/models
CORS_ORIGINS=http://localhost:3000
# In production (ENV=production) the app REFUSES TO START unless JWT_SECRET is a real random
# value (>= 32 chars) and DEMO_PASSWORD is set explicitly.
#   generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=development
JWT_SECRET=
# Password for every seeded demo account (*@demo.healthlens.test), synthetic data only.
# A built-in default is used only when ENV is not production.
DEMO_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
