# Copy to .env.local (gitignored) if you need to change anything. Both values have
# working defaults, so `npm run dev` works with no .env.local at all.

# Where the FastAPI backend is listening. Next rewrites /api/* to ${BACKEND_URL}/api/*,
# so the browser only ever talks to this app's own origin and the session cookie stays
# first-party. On a hosted deployment, point this at the deployed API.
BACKEND_URL=http://127.0.0.1:8000

# The demo password printed on the sign-in page. It must match the backend's DEMO_PASSWORD.
# This is a prototype over synthetic patients: the password is public on purpose.
NEXT_PUBLIC_DEMO_PASSWORD=demo-password-123
